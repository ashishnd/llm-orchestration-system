# Copy to `.env` and fill required values. Docker Compose loads `.env` automatically.

# --- Required ---
OPENAI_API_KEY=
# Database password (used by postgres service and app DSN)
POSTGRES_PASSWORD=

# --- Optional (defaults match docker-compose and app/settings.py) ---
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

POSTGRES_USER=mao
POSTGRES_DB=mao
# Use `postgres` inside Compose; use `localhost` for local API against Compose DB port mapping
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

CHROMA_PERSIST_DIR=/data/chroma
ARXIV_CORPUS_PATH=/data/arxiv_corpus
ARXIV_CATEGORY=cs.CL
ARXIV_MAX_PAPERS=50

DEFAULT_AGENT_BUDGET=3000
ORCHESTRATOR_BUDGET=4000
COMPRESSION_THRESHOLD=0.85

LOG_LEVEL=INFO
LOG_JSON=true

API_HOST=0.0.0.0
API_PORT=8000
